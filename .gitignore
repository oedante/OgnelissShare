# Сборка и служебные файлы Flutter/Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
*.iml
.idea/
.vscode/
.DS_Store
*.log
coverage/

# Rust
rust/target/

# Классы локализации создаёт flutter gen-l10n из lib/l10n/*.arb
lib/l10n/app_localizations*.dart

# Каталоги платформ целиком создаёт tool/bootstrap.py (flutter create +
# накладка tool/platform) — в git их нет; свои файлы для них — в tool/platform.
/android/
/ios/
/macos/
/windows/
/linux/
/.metadata

# И на случай, если каталоги платформ всё же добавят в git, — то, что туда
# не должно попасть ни при каких условиях:
android/key.properties
android/local.properties
*.jks
*.keystore
**/Pods/
**/.symlinks/
**/ephemeral/
**/Flutter/Generated.xcconfig
**/Flutter/flutter_export_environment.sh

# Сборки для выпуска (tool/release/build.py, testflight.sh) и служебное Python
dist/
__pycache__/

# Ключи магазинов: в git — никогда (как получить — docs/RELEASE.md)
*.p8
*.p12
*.mobileprovision
*service-account*.json
play-key*.json
